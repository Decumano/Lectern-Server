DATABASE_URL=sqlite://data/officesuite.db
# Signs session cookies so they can't be tampered with or forged. Must be at
# least 64 characters of random data. Optional for local dev (the server just
# logs a warning and uses unsigned cookies), required by docker-compose.
SESSION_SECRET=change-me-to-a-random-64-byte-value-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PORT=8080
WORKSPACES_DIR=data/workspaces
# Set to true once the server is behind HTTPS so session cookies are sent with
# the Secure flag. Leave false for plain-http local use, or logins will break.
COOKIE_SECURE=false

# docker-compose only: host-side port mapping (container always listens on $PORT)
HOST_PORT=8080
