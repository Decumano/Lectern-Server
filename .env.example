# Copy to .env and adjust. Values already in the environment always win.

# Signs session cookies. At least 64 characters of random data.
# Leave unset for local development (cookies are then unsigned, with a warning).
SESSION_SECRET=

# Set true once the server sits behind HTTPS, so session cookies carry Secure.
COOKIE_SECURE=false

PORT=8080

# SQLite database. A bare path works too; the sqlite:// prefix is accepted so
# a .env from the Rust deployment can be reused unchanged.
DATABASE_URL=sqlite://data/officesuite.db
WORKSPACES_DIR=data/workspaces
FONTS_DIR=data/fonts

# Where the frontend and the migration files are read from.
WEB_DIR=web
MIGRATIONS_DIR=migrations

# Per-account workspace ceiling in bytes; 0 disables the check.
WORKSPACE_QUOTA_BYTES=268435456

# Largest single work file accepted. The default used to be 2MB, inherited
# from axum, which a .mdn notebook (ink, imported PDF pages, images) exceeds
# routinely — the first sync of such a workspace failed with 413.
MAX_WORK_FILE_BYTES=33554432

# Reverse-proxy peers whose X-Forwarded-For is trusted for rate-limit bucketing.
# TRUSTED_PROXIES=127.0.0.1,::1

# Download page: the repo whose latest release is offered, and the token that
# reaches it when it is private. The token never leaves this process.
DESKTOP_RELEASES_REPO=Decumano/OfficeSuite
# GITHUB_RELEASES_TOKEN=

# PDF export needs a Chromium. Set this when it is not in a standard location.
# On Windows it must be Chrome, not Edge — see src/export.cpp.
# CHROME_PATH=

# Handler thread pool, and log verbosity (trace/debug/info/warn/error).
THREADS=8
LOG_LEVEL=info
